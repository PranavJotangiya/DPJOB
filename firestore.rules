rules_version = '2';

// No login screen in this MVP — every visitor is silently signed in via
// Firebase Anonymous Auth (see angular-app/src/app/core/auth.ts) so we can
// require request.auth != null instead of leaving the database open.
// This blocks direct/scripted access that bypasses the app's Firebase SDK;
// it does NOT distinguish between individual real users (no per-user or
// per-role restriction) — that needs real login (email/password or Google
// sign-in) plus a users/{uid} role field, which can be layered on later
// without changing this document shape.
//
// The `users` collection powers an app-level username + PIN login. PINs are
// stored hashed (SHA-256), but any signed-in client can still read the
// collection — this is a "closed team" convenience, not real security.
service cloud.firestore {
  match /databases/{database}/documents {
    match /lots/{lotId} {
      allow read, write: if request.auth != null;
    }
    match /suppliers/{supplierId} {
      allow read, write: if request.auth != null;
    }
    match /parties/{partyId} {
      allow read, write: if request.auth != null;
    }
    match /users/{username} {
      allow read, write: if request.auth != null;
    }
  }
}
