rules_version = '2';

// Locked shut on purpose.
//
// The database is no longer reached from the browser. Every read and write now
// goes through the Node/Express API in server/, which authenticates with a
// Firebase service account — and the Admin SDK bypasses these rules entirely.
//
// So the only thing this file has to do is refuse everything else: a leaked web
// API key, a scripted client, or an old build of the app can no longer touch a
// single document. In particular the `users` collection (which holds the PIN
// hashes) is now unreadable to clients; the server checks PINs itself.
//
// If you ever put a client back on Firestore directly, this is the file that
// has to be opened up again — deliberately, per collection.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
