# Port the API listens on
PORT=8080

# Comma-separated list of origins allowed to call the API.
# Add your Firebase Hosting URL here once deployed.
CORS_ORIGINS=http://localhost:4300,http://localhost:4200,https://dp-creation-f3d30.web.app,https://dp-creation-f3d30.firebaseapp.com

# Secret used to sign login tokens. CHANGE THIS — any long random string.
SESSION_SECRET=change-me-to-a-long-random-string
# How long a login stays valid
SESSION_TTL=30d

# --- Firebase Admin credentials (pick ONE) ---
# 1. Drop the service account JSON next to this file as serviceAccountKey.json
#    (Firebase console -> Project settings -> Service accounts -> Generate new private key)
# 2. Or point at it explicitly:
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/serviceAccountKey.json
# 3. Or paste the whole JSON on one line (handy for Render/Railway/Cloud Run):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

FIREBASE_PROJECT_ID=dp-creation-f3d30
